#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HoldTapMode: HoldTapMode {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAPMODE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        CommaQuestionMode: CommaQuestionMode {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMAQUESTIONMODE";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            tapping-term-ms = <280>;
        };

        LongPress: LongPress {
            compatible = "zmk,behavior-hold-tap";
            label = "LONGPRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };

        DoubleTapSemi: DoubleTapSemi {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLETAPSEMI";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMICOLON>;

            tapping-term-ms = <250>;
        };

        DoubleQuots: DoubleQuots {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLEQUOTS";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES>, <&kp SQT>;

            tapping-term-ms = <250>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        wordLeft: wordLeft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT_ALT) &kp LEFT>;
            label = "WORDLEFT";
        };

        wordRight: wordRight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp RIGHT>;
            label = "WORDRIGHT";
        };

        sentenceLeft: strokeLeft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LEFT>;
            label = "STROKELEFT";
        };

        sentenceRight: sentenceRight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp RIGHT>;
            label = "SENTENCERIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE                                        &kp Q                  &kp W                        &kp E                &kp R                &LongPress LG(T) T    &kp Y    &kp U                &kp I                &kp O                 &kp P                    &kp BSPC
&kp TAB                                           &HoldTapMode LSHIFT A  &HoldTapMode LEFT_CONTROL S  &HoldTapMode LALT D  &HoldTapMode LGUI F  &kp G                 &kp H    &HoldTapMode RGUI J  &HoldTapMode RALT K  &HoldTapMode RCTRL L  &HoldTapMode RSHFT SEMI  &kp SQT
&HoldTapMode LS(LA(LC(LG(LSHIFT)))) LEFT_BRACKET  &LongPress LG(Z) Z     &LongPress LG(X) X           &LongPress LG(C) C   &LongPress LG(V) V   &kp B                 &kp N    &kp M                &kp COMMA            &kp PERIOD            &kp FSLH                 &kp RIGHT_BRACKET
                                                                                                      &CommaQuestionMode   &mo 1                &kp SPACE             &kp RET  &mo 2                &kp LC(SPACE)
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &kp N1         &kp N2     &kp N3      &kp N4          &kp N5    &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&trans  &sentenceLeft  &wordLeft  &wordRight  &sentenceRight  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans         &trans     &trans      &trans          &trans    &trans    &trans    &trans  &trans     &trans  &trans
                                  &trans      &trans          &trans    &trans    &trans    &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TILDE  &kp EXCL  &kp AT    &kp HASH        &kp DLLR       &kp PRCNT    &kp CARET        &kp AMPS  &kp KP_MULTIPLY  &trans    &trans          &trans
&trans     &trans    &kp LPAR  &kp UNDERSCORE  &kp RPAR       &kp EQUAL    &kp C_VOLUME_UP  &kp LBRC  &kp MINUS        &kp RBRC  &DoubleTapSemi  &DoubleQuots
&trans     &trans    &trans    &trans          &kp BACKSLASH  &kp PLUS     &kp C_VOL_DN     &kp LBKT  &trans           &kp RBKT  &trans          &trans
                               &trans          &trans         &kp SPACE    &kp RET          &trans    &trans
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
