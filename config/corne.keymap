#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HoldTapMode: HoldTapMode {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAPMODE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        CommaQuestionMode: CommaQuestionMode {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMAQUESTIONMODE";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            tapping-term-ms = <280>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE                                   &kp Q                 &kp W                &kp E                 &kp R                &kp T        &kp Y    &kp U                &kp I                &kp O                 &kp P                    &kp BSPC
&HoldTapMode LS(LA(LC(LG(LEFT_SHIFT)))) TAB  &HoldTapMode LSHFT A  &HoldTapMode LALT S  &HoldTapMode LCTRL D  &HoldTapMode LGUI F  &kp G        &kp H    &HoldTapMode RGUI J  &HoldTapMode RALT K  &HoldTapMode RCTRL L  &HoldTapMode RSHFT SEMI  &kp SQT
&kp LEFT_BRACKET                             &kp Z                 &kp X                &kp C                 &kp V                &kp B        &kp N    &kp M                &kp COMMA            &kp PERIOD            &kp FSLH                 &kp RIGHT_BRACKET
                                                                                        &CommaQuestionMode    &mo 1                &kp SPACE    &kp RET  &mo 2                &kp LC(SPACE)
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp TAB    &kp N1  &kp N2  &kp N3                 &kp N4  &kp N5       &kp N6    &kp N7    &kp N8         &kp N9     &kp N0  &kp BSPC
&kp LCTRL  &trans  &trans  &trans                 &trans  &trans       &kp LEFT  &kp DOWN  &kp UP         &kp RIGHT  &trans  &trans
&kp LSHFT  &trans  &trans  &trans                 &trans  &trans       &trans    &trans    &trans         &trans     &trans  &trans
                           &kp LC(LA(LG(LSHFT)))  &trans  &kp SPACE    &kp RET   &trans    &kp LC(SPACE)
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TILDE  &kp EXCL  &kp AT    &kp HASH        &kp DLLR       &kp PRCNT    &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &trans    &trans  &trans
&trans     &trans    &kp LPAR  &kp UNDERSCORE  &kp RPAR       &kp EQUAL    &trans     &kp LBRC  &kp MINUS        &kp RBRC  &trans  &trans
&trans     &trans    &trans    &trans          &kp BACKSLASH  &kp PLUS     &trans     &kp LBKT  &kp LBRC         &kp RBKT  &trans  &trans
                               &trans          &trans         &kp SPACE    &kp RET    &trans    &trans
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
